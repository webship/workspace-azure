{
  "name": "@webship.co/workspace-azure",
  "version": "1.0.0-rc1",
  "description": "Azure App Service for Webship Workspace: the AZURE menu on every site row, the web app and its deployment slots with their URLs, zip deploy, log tail, deployment history. A provider of @webship.co/workspace-hosting.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-azure.git"
  },
  "files": [
    "dist/src",
    "commands",
    "config",
    "features",
    "scripts",
    "README.md",
    "ddev",
    "host-mounts.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "azure",
    "label": "Azure",
    "settingsFile": "plugin.azure.settings.yml",
    "settingsTemplate": "config/plugin.azure.settings.yml",
    "labels": "config/settings.labels.yml",
    "legacySettingsKey": "azure",
    "typeActions": {
      "azure": [
        "sites"
      ]
    },
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "demos",
        "sandboxes",
        "projects"
      ],
      "files": [
        "commands/cmd-tools-azure.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-azure.sh",
        "scripts/functions/fun-azure-tool.sh"
      ],
      "args": [
        "scripts/args/arg-azure.sh"
      ],
      "hostInstall": "scripts/host-install.sh"
    },
    "features": [
      "features/azure.feature"
    ],
    "ddev": {
      "compose": [
        "ddev/docker-compose.azure-cli.yaml"
      ],
      "hostMounts": [
        "~/.azure"
      ]
    }
  },
  "dependencies": {
    "@webship.co/workspace-hosting": "^1.0.0-rc1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.0-rc1",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
