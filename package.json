{
  "name": "@webship.co/workspace-azure",
  "version": "1.0.12",
  "description": "Azure App Service for Webship Workspace: the AZURE menu on every site row, the web app and its deployment slots with their URLs, zip deploy, log tail, deployment history. It carries its AI items, each placed in the workspace folder of its kind: an agent, a skill, a command and a prompt. A provider of @webship.co/workspace-hosting.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-azure.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "features",
    "scripts",
    "README.md",
    "ddev",
    "host-mounts.txt",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "azure",
    "label": "Azure",
    "needs": {
      "plugins": [
        [
          "dev",
          "test",
          "demos",
          "sandboxes",
          "projects"
        ],
        "ai-agents",
        "ai-skills",
        "ai-commands",
        "ai-prompts"
      ],
      "commands": [
        {
          "command": "az",
          "hint": "https://learn.microsoft.com/cli/azure/install-azure-cli"
        }
      ]
    },
    "settingsFile": "plugin.azure.settings.yml",
    "settingsTemplate": "config/plugin.azure.settings.yml",
    "labels": "config/settings.labels.yml",
    "legacySettingsKey": "azure",
    "typeActions": {
      "azure": [
        "sites"
      ]
    },
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "demos",
        "sandboxes",
        "projects"
      ],
      "files": [
        "commands/cmd-tools-azure.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-azure.sh",
        "scripts/functions/fun-azure-tool.sh"
      ],
      "args": [
        "scripts/args/arg-azure.sh"
      ],
      "hostInstall": "scripts/host-install.sh"
    },
    "ai": {
      "agents": [
        "ai/agents/azure-deployer.md"
      ],
      "skills": [
        "ai/skills/azure-hosting"
      ],
      "commands": [
        "ai/commands/azure-status.md"
      ],
      "prompts": [
        "ai/prompts/azure-test-then-deploy.md"
      ]
    },
    "features": [
      "features/azure.feature"
    ],
    "ddev": {
      "compose": [
        "ddev/docker-compose.azure-cli.yaml"
      ],
      "hostMounts": [
        "~/.azure"
      ]
    }
  },
  "dependencies": {
    "@webship.co/workspace-hosting": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
